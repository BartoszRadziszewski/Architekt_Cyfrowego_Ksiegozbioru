# Google Drive API 
# Ścieżka do pliku JSON klucza Service Account pobranego z Google Cloud Platform
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# ID Głównego folderu 'Books' na dysku Google
DRIVE_BOOKS_FOLDER_ID=your_drive_books_folder_id_here

# ID folderów archiwalnych
DRIVE_ARCHIVE_SYSTEM_FOLDER_ID=your_archive_system_folder_id_here
DRIVE_ARCHIVE_OLD_FORMATS_FOLDER_ID=your_archive_old_formats_folder_id_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
